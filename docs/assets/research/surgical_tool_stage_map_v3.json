  "hard_invariants": [
    "not(ischemic_evt.active && open_cranial_hemorrhage.active)",
    "not(ischemic_evt.active && postoperative_head_dressing.visible)",
    "not(ischemic_evt.active && optional_evd_system.visible)",
    "not(ischemic_evt.active && craniotomy_bone_flap.visible)",
    "not(evtTechnique == 'contactAspiration' && stentRetrieverAction.visible)",
    "not(evtTechnique == 'stentRetriever' && aspirationAction.visible)",
    "not(openApproach == 'minimallyInvasive' && openEvacuationAction.visible)",
    "not(boneClosure == 'decompressiveLeaveOff' && boneFlapFixation.visible)",
    "not(evdState == 'clinicianSelected' && !clinicalEVDSelectionConfirmed)",
    "not(magnifiedInspectionEntity === registeredPatientToolEntity)"
  ],
