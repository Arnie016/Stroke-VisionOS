    "aspiration": "symbolic arrows/canister state; no vacuum, pressure, fluid, clot, or efficacy solver",
    "contrast": "qualitative overlay; no injection, perfusion, dose, or radiation model",
    "open_cutting_tools": "approach/withdraw kinematics only; no cutting, fracture, heat, force, or trajectory model",
    "retraction_and_head_holding": "static/small kinematic placement; no force, tissue pressure, or safety model",
    "hemostasis": "state cue only; no thermal, electrical, blood-loss, sealing, or success model",
    "evd": "static/kinematic teaching model; no trajectory, CSF, ICP, level, waveform, or drainage model"
  },
